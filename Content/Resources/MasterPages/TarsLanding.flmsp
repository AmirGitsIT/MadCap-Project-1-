<?xml version="1.0" encoding="utf-8"?>
<html xmlns:MadCap="http://www.madcapsoftware.com/Schemas/MadCap.xsd">
	<head>
		<link href="../Stylesheets/Styles.css" rel="stylesheet" type="text/css" />
	</head>

	<body class="tars-home-body">

		<!-- =====================================================
		TARS STARTUP OVERLAY
		===================================================== -->

		<div id="tars-loader">


			<!-- =================================================
			TARS VOICE
			================================================= -->

			<audio id="tars-welcome-audio" preload="auto">
				<source src="../../Tars Voice.mp3" type="audio/mpeg" />
			</audio>


			<!-- =================================================
			STARTUP STATUS
			================================================= -->

			<div class="tars-loader-status">

				<p class="tars-loader-title">
					TARS
				</p>

				<p class="tars-loader-init">
					INITIALIZING KNOWLEDGE ARCHITECTURE
				</p>

				<p class="tars-loader-line tars-line-1">
					&gt; Loading knowledge engine...
				</p>

				<p class="tars-loader-line tars-line-2">
					&gt; Mapping knowledge nodes...
				</p>

				<p class="tars-loader-line tars-line-3">
					&gt; Establishing system interface...
				</p>

				<p class="tars-loader-line tars-line-4">
					&gt; Initializing search architecture...
				</p>

				<p class="tars-loader-line tars-line-5">
					&gt; Validating knowledge base...
				</p>

				<p class="tars-loader-online">
					KNOWLEDGE CORE ONLINE
				</p>


				<!-- =============================================
				AUDIO FALLBACK

				Hidden unless audible autoplay is blocked.
				============================================= -->

				<div id="tars-audio-control">

					<p class="tars-audio-label">
						TARS AUDIO CHANNEL AVAILABLE
					</p>

					<button id="tars-audio-enable"
						type="button">
						INITIALIZE VOICE INTERFACE
					</button>

				</div>

			</div>


			<!-- =================================================
			STARTUP CUBE
			================================================= -->

			<div class="tars-loader-surface">

				<div class="tars-loader-box">

					<div class="tars-loader-cube">
					</div>

				</div>

			</div>

		</div>


		<!-- =====================================================
		FLARE TOPIC CONTENT
		===================================================== -->

		<MadCap:bodyProxy />


		<!-- =====================================================
		TARS STARTUP CONTROLLER
		===================================================== -->

		<script type="text/javascript">
			window.addEventListener('load', function ()
			{
			var loader = document.getElementById('tars-loader');
			var tarsHome = document.querySelector('.tars-home');

			var tarsVoice =
			document.getElementById('tars-welcome-audio');

			var audioControl =
			document.getElementById('tars-audio-control');

			var audioEnable =
			document.getElementById('tars-audio-enable');


			/* ---------------------------------------------
			MODULE INITIALIZATION
			--------------------------------------------- */

			function initializeModules()
			{
			if (tarsHome)
			{
			tarsHome.classList.add('tars-modules-online');
			}
			}


			/* ---------------------------------------------
			HIDE AUDIO CONTROL
			--------------------------------------------- */

			function hideAudioControl()
			{
			if (audioControl)
			{
			audioControl.style.display = 'none';
			}
			}


			/* ---------------------------------------------
			SHOW AUDIO CONTROL
			--------------------------------------------- */

			function showAudioControl()
			{
			if (audioControl)
			{
			audioControl.style.display = 'block';
			}
			}


			/* ---------------------------------------------
			PLAY TARS VOICE
			--------------------------------------------- */

			function playTarsVoice()
			{
			if (!tarsVoice)
			{
			return;
			}

			tarsVoice.volume = 0.90;

			var playback = tarsVoice.play();

			if (playback !== undefined)
			{
			playback.then(function ()
			{
			hideAudioControl();
			});

			playback.catch(function ()
			{
			showAudioControl();
			});
			}
			}


			/* ---------------------------------------------
			MANUAL AUDIO INITIALIZATION

			The button click is a real browser user
			gesture, allowing audible playback.
			--------------------------------------------- */

			if (audioEnable)
			{
			audioEnable.addEventListener('click', function ()
			{
			playTarsVoice();
			});
			}


			/* ---------------------------------------------
			NO LOADER
			--------------------------------------------- */

			if (!loader)
			{
			initializeModules();
			return;
			}


			/* ---------------------------------------------
			STARTUP ALREADY COMPLETED THIS SESSION

			Skip loader and voice.
			--------------------------------------------- */

			if (sessionStorage.getItem('tarsStartupShown') === 'true')
			{
			loader.style.display = 'none';

			window.setTimeout(function ()
			{
			initializeModules();
			}, 300);

			return;
			}


			/* ---------------------------------------------
			NEW STARTUP SESSION
			--------------------------------------------- */

			sessionStorage.setItem('tarsStartupShown', 'true');

			hideAudioControl();


			/* ---------------------------------------------
			ATTEMPT TARS VOICE AT 2.3 SECONDS

			If Chrome allows audible autoplay, the voice
			simply begins.

			If blocked, the manual audio control appears.
			--------------------------------------------- */

			window.setTimeout(function ()
			{
			playTarsVoice();

			}, 1300);


			/* ---------------------------------------------
			COMPLETE STARTUP AT 10 SECONDS
			--------------------------------------------- */

			window.setTimeout(function ()
			{
			loader.classList.add('tars-loader-hidden');

			window.setTimeout(function ()
			{
			initializeModules();
			}, 650);

			}, 10000);
			});
		</script>

	</body>
</html>
<?xml version="1.0" encoding="utf-8"?>
<CatapultTarget
  Version="2"
  Comment="MadCap HTML5 Target"
  Type="WebHelp2"
  Destinations=""
  ShowMadCapBacklink="true"
  GlossaryTermConversion="marked"
  ResolveCssVariables="true"
  DefaultUrl="/Content/START_HERE.htm"
  PatchHeadingLevels="true"
  ConditionTagExpression="include[Default.Web], exclude[Default.PrintOnly]"
  EquationsOutputType="PNG"
  ContentInclusionType="Referenced">
  <PrintedOutput
    CollapseMargins="true"
    GenerateTOCProxy="true"
    GenerateIndexProxy="true"
    GenerateGlossaryProxy="true"
    OutputFormat="doc" />
</CatapultTarget>